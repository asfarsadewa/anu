{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anu",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    // node build.mjs writes the site to dist/. Only that folder is uploaded
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "anu.asfarlab.fun", "custom_domain": true }],
  "vars": {
    // The Turnstile widget of the werewolf repo. Site keys are public. The secret lives in the TURNSTILE_SECRET secret.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE71xM46w_8YxSSd",
    // Hostnames that siteverify must report. Never localhost in production.
    "TURNSTILE_HOSTNAMES": "anu.asfarlab.fun"
  },
  // Secrets: TURNSTILE_SECRET, SESSION_SECRET.
  "ratelimits": [
    {
      // Session starts per minute per IP.
      "name": "SESSION_LIMITER",
      "namespace_id": "1301",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
